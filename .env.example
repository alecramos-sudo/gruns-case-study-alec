# Required only for AI-generated pairing recommendations.
OPENAI_API_KEY=

# Alternative OpenAI-compatible provider credential.
# AI_API_KEY=

# Optional provider overrides.
AI_MODEL=gpt-5.6-luna
AI_BASE_URL=https://api.openai.com/v1

# Optional bounded daily limits. Defaults are suitable for the dev-store demo.
AI_DAILY_SHOP_LIMIT=20
AI_DAILY_GLOBAL_LIMIT=100
